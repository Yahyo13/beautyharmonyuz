rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary compatibility rules for the current client-side app.
    // The site uses Clerk for customers and a custom admin session for admins,
    // so Firestore cannot see those identities from browser SDK requests yet.
    // Move admin/customer writes behind server API routes with Firebase Admin
    // before making these rules stricter.

    match /products/{document=**} {
      allow read, write: if true;
    }

    match /settings/{document=**} {
      allow read, write: if true;
    }

    match /promoCodes/{document=**} {
      allow read, write: if true;
    }

    match /orders/{document=**} {
      allow read, write: if true;
    }

    match /supportThreads/{document=**} {
      allow read, write: if true;
    }

    match /users/{document=**} {
      allow read, write: if true;
    }
  }
}
